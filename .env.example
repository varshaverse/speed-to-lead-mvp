# ==============================================================================
# SPEED-TO-LEAD AUTOMATION (BLAZE AI CFO) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. REAL LLM MODE (OpenAI Structured Outputs)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini


SHEET_WEBHOOK_URL=
SHEET_SECRET=

# 2. NOTIFICATION CHANNELS
# Primary: Discord Webhook URL (Paste your channel webhook URL to enable real Discord embeds)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Optional: Slack Webhook URL
SLACK_WEBHOOK_URL=

# Optional: Twilio SMS Alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_TO_PHONE=

# Optional: SMTP Email Alerts
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 3. DURABLE STORAGE ENGINE
# Supabase (Optional: automatically uses local SQLite if left empty)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 4. SECURITY & META FACEBOOK WEBHOOK HANDSHAKE
WEBHOOK_SECRET=speed-to-lead-secret
FB_VERIFY_TOKEN=speed-to-lead-token
FB_APP_SECRET=

# 5. SLA BENCHMARK
TARGET_SLA_SECONDS=60
